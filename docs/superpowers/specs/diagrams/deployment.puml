@startuml deployment
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml

LAYOUT_WITH_LEGEND()

title Deployment Diagram - JVM Scripting Engine & Profiler

Deployment_Node(dev_workstation, "Developer Workstation", "Linux/macOS/Windows") {
    Deployment_Node(jvm, "JVM Process", "OpenJDK 17+") {
        Container(engine_core_jar, "engine-core.jar", "Java Application", "Main application JAR containing rules engine")
        Container(engine_profiler_jar, "engine-profiler.jar", "Java Library", "Profiler module loaded as dependency")
        Container(agent_jar, "engine-agent.jar", "Java Agent", "Instrumentation agent attached via -javaagent")
        
        Deployment_Node(heap, "JVM Heap", "Memory") {
            Container(l1_cache, "L1 Cache", "Strong References", "Hot rules in memory")
            Container(l2_cache, "L2 Cache", "Soft References", "Warm rules, GC-friendly")
            Container(l3_cache, "L3 Cache", "Weak References", "Cold rules, GC-aggressive")
        }
        
        Deployment_Node(metaspace, "Metaspace", "Non-Heap Memory") {
            Container(rule_classes, "Generated Rule Classes", "Class Metadata", "Dynamically generated bytecode classes")
            Container(classloaders, "Rule ClassLoaders", "ClassLoader Instances", "Hierarchical ClassLoader tree")
        }
        
        Deployment_Node(native_memory, "Native Memory", "Off-Heap") {
            Container(async_profiler_native, "async-profiler Native Lib", "libasyncProfiler.so", "Low-overhead profiling")
        }
    }
    
    Deployment_Node(filesystem, "File System", "Local Storage") {
        Container(rule_files, "Rule Definitions", "JSON Files", "User-defined rules")
        Container(logs, "Log Files", "hotspot.log, gc.log", "JVM diagnostic logs")
        Container(jfr_recordings, "JFR Recordings", "recording.jfr", "Flight Recorder data")
        Container(flamegraphs, "Flame Graphs", "flamegraph.html", "Performance visualizations")
    }
    
    Deployment_Node(monitoring_tools, "Monitoring Tools", "Desktop Applications") {
        Container(jconsole, "JConsole", "JMX Client", "Real-time JMX monitoring")
        Container(jmc, "JDK Mission Control", "JFR Viewer", "JFR recording analysis")
        Container(visualvm, "VisualVM", "Profiling Tool", "Heap dumps, thread analysis")
    }
}

Deployment_Node(ci_server, "CI/CD Server", "GitHub Actions / GitLab CI", "Optional") {
    Deployment_Node(build_jvm, "Build JVM", "OpenJDK 17+") {
        Container(maven, "Maven", "Build Tool", "Builds and tests all modules")
        Container(jmh_runner, "JMH Benchmark Runner", "Java", "Executes performance benchmarks")
    }
    
    Deployment_Node(artifacts, "Build Artifacts", "File Storage") {
        Container(jars, "JAR Files", "engine-*.jar", "Built artifacts")
        Container(benchmark_results, "Benchmark Results", "JSON Reports", "Performance baselines")
    }
}

' Relationships
Rel(engine_core_jar, agent_jar, "Instrumented by", "Instrumentation API")
Rel(engine_core_jar, engine_profiler_jar, "Uses", "Java API")

Rel(engine_core_jar, l1_cache, "Caches rules", "Strong refs")
Rel(engine_core_jar, l2_cache, "Caches rules", "Soft refs")
Rel(engine_core_jar, l3_cache, "Caches rules", "Weak refs")

Rel(engine_core_jar, rule_classes, "Loads", "ClassLoader")
Rel(engine_core_jar, classloaders, "Manages", "ClassLoader hierarchy")

Rel(engine_profiler_jar, async_profiler_native, "Invokes", "JNI")

Rel(engine_core_jar, rule_files, "Reads", "JSON parsing")
Rel(engine_profiler_jar, logs, "Writes/Reads", "Log parsing")
Rel(engine_profiler_jar, jfr_recordings, "Generates", "JFR API")
Rel(engine_profiler_jar, flamegraphs, "Generates", "HTML")

Rel(agent_jar, jconsole, "Exposes MBeans", "JMX")
Rel(jfr_recordings, jmc, "Viewed in", "File open")
Rel(engine_core_jar, visualvm, "Monitored by", "JMX/JVMTI")

Rel(maven, jars, "Produces", "Build output")
Rel(jmh_runner, benchmark_results, "Produces", "JSON output")

@enduml
