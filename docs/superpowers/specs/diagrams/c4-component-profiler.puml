@startuml c4-component-profiler
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Component Diagram - Profiler Module

Container_Boundary(profiler, "Profiler Module") {
    Component(jit_monitor, "JIT Compilation Monitor", "Java", "Parses -XX:+PrintCompilation output, tracks tiered compilation")
    Component(compilation_tracker, "Tiered Compilation Tracker", "Java", "Records tier transitions (C1 → C2)")
    Component(inlining_analyzer, "Inlining Analyzer", "Java", "Analyzes JIT inlining decisions")
    
    Component(gc_analyzer, "GC Log Analyzer", "Java", "Parses GC logs, calculates statistics")
    Component(gc_event_parser, "GC Event Parser", "Java", "Extracts pause times, collection types")
    Component(safepoint_analyzer, "Safepoint Analyzer", "Java", "Tracks safepoint occurrences")
    
    Component(async_integration, "async-profiler Integration", "Java", "Controls async-profiler, generates flame graphs")
    Component(flamegraph_generator, "FlameGraph Generator", "Java", "Produces HTML flame graphs")
    Component(profile_comparator, "Profile Comparator", "Java", "Compares before/after profiles")
    
    Component(jfr_recorder, "JFR Event Recorder", "Java", "Records custom JFR events")
    Component(jfr_event_definitions, "JFR Event Definitions", "Java", "Custom event types (RuleExecution, Compilation, etc.)")
    Component(jfr_manager, "JFR Recording Manager", "Java", "Manages JFR recording lifecycle")
    
    Component(live_dashboard, "Live Dashboard", "Java", "Terminal-based real-time profiler UI")
    Component(dashboard_renderer, "Dashboard Renderer", "Java", "Renders metrics to terminal")
}

Container_Ext(engine_core, "Engine Core", "Rules engine")
Container_Ext(async_profiler_lib, "async-profiler", "Native library")
System_Ext(jfr_viewer, "JDK Mission Control", "JFR viewer")
System_Ext(hotspot_logs, "HotSpot Logs", "Compilation/GC logs")

Rel(jit_monitor, compilation_tracker, "Records events", "CompilationEvent")
Rel(jit_monitor, inlining_analyzer, "Analyzes", "Inlining decisions")
Rel(jit_monitor, hotspot_logs, "Reads", "Log parsing")

Rel(gc_analyzer, gc_event_parser, "Uses", "Parser")
Rel(gc_analyzer, safepoint_analyzer, "Tracks", "Safepoint events")
Rel(gc_analyzer, hotspot_logs, "Reads", "GC logs")

Rel(async_integration, flamegraph_generator, "Generates", "HTML")
Rel(async_integration, profile_comparator, "Compares", "Profiles")
Rel(async_integration, async_profiler_lib, "Invokes", "JNI")

Rel(jfr_recorder, jfr_event_definitions, "Uses", "Event types")
Rel(jfr_recorder, jfr_manager, "Manages", "Recordings")
Rel(jfr_manager, jfr_viewer, "Outputs", "JFR files")

Rel(live_dashboard, dashboard_renderer, "Renders", "Terminal output")
Rel(live_dashboard, jit_monitor, "Queries", "Stats")
Rel(live_dashboard, gc_analyzer, "Queries", "Stats")

Rel(engine_core, jfr_recorder, "Emits events", "JFR events")
Rel(engine_core, jit_monitor, "Triggers monitoring", "JVM flags")

@enduml
