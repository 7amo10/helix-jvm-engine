@startuml c4-context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title System Context Diagram - JVM Scripting Engine & Profiler

Person(developer, "Java Developer", "Studies JVM internals, runs experiments, analyzes performance")
Person(operator, "System Operator", "Monitors engine health, manages deployments")

System(engine, "JVM Scripting Engine", "Dynamic rules engine with bytecode generation, execution, and deep JVM profiling capabilities")

System_Ext(jconsole, "JConsole/VisualVM", "JMX monitoring tools")
System_Ext(jfr_viewer, "JDK Mission Control", "JFR recording viewer")
System_Ext(async_profiler, "async-profiler", "Low-overhead profiling tool")

Rel(developer, engine, "Defines JSON rules, runs experiments", "JSON, CLI")
Rel(operator, engine, "Monitors metrics, health checks", "JMX, REST")

Rel(engine, jconsole, "Exposes runtime metrics", "JMX")
Rel(engine, jfr_viewer, "Generates recordings", "JFR")
Rel(engine, async_profiler, "Generates flame graphs", "Native library")

Rel_Back(jconsole, operator, "Views metrics, triggers operations")
Rel_Back(jfr_viewer, developer, "Analyzes performance events")

@enduml
